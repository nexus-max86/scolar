# Connexion PostgreSQL (local, Supabase, Neon...).
# Avec Supabase, utilisez l'URL du "Session pooler" ou la connexion directe.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/scolar

# Secret pour signer les sessions (au moins 32 caractères aléatoires).
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=remplacez-moi-par-une-longue-chaine-aleatoire

# Adresse publique du site, utilisée dans les liens envoyés aux parents (facultatif en local).
APP_URL=https://scolar.example.cd

# Remise à zéro de l'école de démonstration chaque nuit (Vercel envoie ce secret à /api/demo/reset).
CRON_SECRET=remplacez-moi-par-un-autre-secret

# Contact affiché sur la page d'accueil (bouton « Demander une présentation »). L'un ou l'autre.
CONTACT_WHATSAPP=
CONTACT_EMAIL=

# Mettre 1 pour fermer la démo publique (/demo).
DEMO_DISABLED=

# Compte administrateur plateforme créé au premier déploiement (s'il n'en existe aucun).
ADMIN_EMAIL=
ADMIN_PASSWORD=
